# Copy this file to ".env" and fill in your SMTP credentials.
# These power the contact form (/api/contact).

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where contact form submissions are sent, and the From address.
CONTACT_TO=contact@resolveit.nl
CONTACT_FROM=website@resolveit.nl

# LinkedIn Community Management API, used to draft posts for blog articles.
# Only needed locally by scripts/linkedin-*.mjs, not by the website itself.
# See docs/linkedin-integratie.md for the full setup.
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://resolveit.nl/oauth/linkedin/callback

# Filled in automatically by scripts/linkedin-auth.mjs; do not set by hand.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_ORGANIZATION_URN=
