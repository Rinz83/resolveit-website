---
// Confirmation page shown after a Pardot form submits (its redirect target).
//
// The copy is Dutch by default: the forms redirect to one fixed URL regardless
// of which language page the visitor was on, and most visitors are Dutch. When
// the visitor came from an /en/ page the inline script below swaps the copy to
// English. The language marker is written to sessionStorage by the layout on
// every regular pageview, because the Pardot redirect arrives from the
// go.resolveit.nl iframe and carries no usable referrer.
const {
  message,
  messageEn,
  ctaHref = '/',
  ctaLabel = 'Terug naar home',
  ctaLabelEn = 'Back to home',
  source = 'form',
} = Astro.props;
---
<section class="ty" data-ty-source={source}>
  <div class="ty-aurora" aria-hidden="true"><span></span><span></span></div>
  <div class="container ty-inner">
    <div class="ty-check" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h1 data-ty-h1>Bedankt!</h1>
    <p data-ty-message>{message}</p>
    <div class="ty-actions">
      <a href={ctaHref} class="btn btn-primary" data-ty-cta>{ctaLabel}</a>
      <a href="/" class="btn btn-outline" data-ty-home>Terug naar home</a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ messageEn, ctaLabelEn }}>
  (function () {
    var lang = null;
    try { lang = sessionStorage.getItem('riy-lang'); } catch (e) {}
    if (lang === 'en') {
      var set = function (sel, text) {
        var el = document.querySelector(sel);
        if (el && text) el.textContent = text;
      };
      set('[data-ty-h1]', 'Thank you!');
      set('[data-ty-message]', messageEn);
      set('[data-ty-cta]', ctaLabelEn);
      set('[data-ty-home]', 'Back to home');
      // Point the buttons at the English pages as well.
      var toEn = function (sel) {
        var el = document.querySelector(sel);
        if (!el) return;
        var href = el.getAttribute('href') || '/';
        if (!href.startsWith('/en')) el.setAttribute('href', href === '/' ? '/en/' : '/en' + href);
      };
      toEn('[data-ty-cta]');
      toEn('[data-ty-home]');
      document.documentElement.lang = 'en';
    }

    // Landing on a thank-you page means a form was submitted: push the lead
    // conversion into the dataLayer for the Tag Manager container.
    var ty = document.querySelector('.ty[data-ty-source]');
    if (ty) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'generate_lead',
        method: 'pardot',
        form_source: ty.getAttribute('data-ty-source') || 'form',
      });
    }
  })();
</script>

<style>
.ty { background: var(--color-dark); color: #fff; min-height: 70vh; display: flex; align-items: center; position: relative; overflow: hidden; padding: 5rem 0; }
.ty-aurora { position: absolute; inset: 0; z-index: 0; }
.ty-aurora span { position: absolute; border-radius: 50%; filter: blur(80px); }
.ty-aurora span:nth-child(1) { width: 460px; height: 460px; background: rgba(109,183,87,0.4); top: -150px; left: -80px; animation: drift 20s ease-in-out infinite; }
.ty-aurora span:nth-child(2) { width: 400px; height: 400px; background: rgba(108,68,148,0.4); bottom: -150px; right: -80px; animation: drift 24s ease-in-out infinite reverse; }
.ty-inner { position: relative; z-index: 1; max-width: 620px; margin: 0 auto; text-align: center; }
.ty-check { width: 84px; height: 84px; margin: 0 auto 1.75rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg, var(--color-green), var(--color-green-dark)); box-shadow: 0 12px 30px rgba(109,183,87,0.4); }
.ty-check svg { width: 40px; height: 40px; }
.ty-inner h1 { color: #fff; font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem; }
.ty-inner p { color: rgba(255,255,255,0.8); font-size: 1.15rem; margin-bottom: 2rem; }
.ty-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>
