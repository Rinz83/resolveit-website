---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, translatedPaths } from '../i18n/ui.js';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
  noindex?: boolean;
  image?: string;
  ogType?: string;
  breadcrumbs?: { name: string; item: string }[];
}

// Default social-share image: purpose-built 1200x630 branded OG card.
const DEFAULT_OG_IMAGE = '/images/og-default.png';

const {
  title,
  description = 'Resolve IT helpt organisaties het volledige potentieel van Salesforce te benutten. Implementatie, integraties, training en consultancy.',
  transparentHeader = true,
  noindex = false,
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  breadcrumbs,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.resolveit.nl');
const lang = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/') ? 'en' : 'nl';
const ogImage = new URL(image, Astro.site ?? 'https://www.resolveit.nl').href;
const ogLocale = lang === 'en' ? 'en_GB' : 'nl_NL';

// hreflang alternates: emit NL/EN links only for pages that exist in both
// languages (the primary language flipped to NL at root, EN under /en/).
const siteBase = Astro.site ?? 'https://www.resolveit.nl';
const pn = Astro.url.pathname;
const nlClean = (getLangFromUrl(pn) === 'en' ? pn.replace(/^\/en/, '') : pn).replace(/\/$/, '') || '/';
const hasAlternate = translatedPaths.has(nlClean);
const nlHref = new URL(nlClean, siteBase).href;
const enHref = new URL(nlClean === '/' ? '/en' : `/en${nlClean}`, siteBase).href;

// Cookie-consent banner copy (bilingual).
const cc = lang === 'en'
  ? { text: 'We use cookies to analyse website traffic and improve your experience.',
      more: 'Cookie policy', link: '/en/cookiebeleid', accept: 'Accept', decline: 'Decline' }
  : { text: 'We gebruiken cookies om websiteverkeer te analyseren en onze site te verbeteren.',
      more: 'Cookiebeleid', link: '/cookiebeleid', accept: 'Accepteren', decline: 'Weigeren' };
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <title>{title} | Resolve IT</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />

  {hasAlternate && (
    <>
      <link rel="alternate" hreflang="nl-NL" href={nlHref} />
      <link rel="alternate" hreflang="en" href={enHref} />
      <link rel="alternate" hreflang="x-default" href={nlHref} />
    </>
  )}

  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${title} | Resolve IT`} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={`${title} | Resolve IT`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Resolve IT`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Organization + WebSite entity (site-wide) — helps Google's Knowledge
       Panel and AI engines identify and cite the brand. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': 'https://www.resolveit.nl/#organization',
        name: 'Resolve IT',
        url: 'https://www.resolveit.nl/',
        logo: 'https://www.resolveit.nl/images/Logo-colored.png',
        email: 'contact@resolveit.nl',
        telephone: '+31411799828',
        description: 'Salesforce Gold Partner: implementation, integrations, training and consultancy.',
        address: { '@type': 'PostalAddress', addressCountry: 'NL' },
        sameAs: ['https://www.linkedin.com/company/resolveitnow/'],
      },
      {
        '@type': 'WebSite',
        '@id': 'https://www.resolveit.nl/#website',
        url: 'https://www.resolveit.nl/',
        name: 'Resolve IT',
        publisher: { '@id': 'https://www.resolveit.nl/#organization' },
        inLanguage: lang === 'en' ? 'en' : 'nl-NL',
      },
    ],
  })} is:inline />

  {breadcrumbs && breadcrumbs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.item, 'https://www.resolveit.nl').href,
      })),
    })} is:inline />
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Analytics 4 (gtag) with Consent Mode v2 — storage stays denied
       until the visitor accepts the cookie banner (AVG/GDPR compliant). -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
    // Re-apply a stored choice from a previous visit before GA loads.
    try {
      if (localStorage.getItem('riy-consent') === 'granted') {
        gtag('consent', 'update', {
          ad_storage: 'granted', ad_user_data: 'granted',
          ad_personalization: 'granted', analytics_storage: 'granted',
        });
      }
    } catch (e) {}
    gtag('js', new Date());
    gtag('config', 'G-N45J4VLRC2');
    // Google Ads, so the conversion labels carried over from Tag Manager have an
    // account to report into. gtag handles the conversion linker itself, which is
    // what the container's Conversion Linker tag did.
    gtag('config', 'AW-16749801902');
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-N45J4VLRC2" is:inline></script>

  <!-- Salesforce Account Engagement (Pardot) — account 982612, campaign 28209.
       Lived in the old WordPress theme rather than in Tag Manager, which is why it
       disappeared with the rebuild and the dashboard went quiet.

       Loaded from go.resolveit.nl, the tracker domain that already serves the
       forms, instead of the old pi.pardot.com: same script, but the visitor cookie
       is first-party, so Safari and Firefox no longer discard it.

       Deliberately NOT behind the cookie banner, unlike the trackers further down,
       so page views are recorded for every visitor. Note that first-party only
       decides whether browsers keep the cookie, not whether consent is required;
       this is an explicit business decision, not an oversight. -->
  <script is:inline>
    window.piAId = '982612';
    window.piCId = '28209';
    window.piHostname = 'go.resolveit.nl';
  </script>
  <script async src="https://go.resolveit.nl/pd.js" is:inline></script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- Calendly popup widget (on-page overlay for booking links) -->
  <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
  <script src="https://assets.calendly.com/assets/external/widget.js" async is:inline></script>
</head>
<body>
  <Nav transparent={transparentHeader} />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  <div id="cookie-consent" class="cc-banner" hidden>
    <p class="cc-text">
      {cc.text} <a href={cc.link}>{cc.more}</a>
    </p>
    <div class="cc-actions">
      <button type="button" class="cc-btn cc-decline">{cc.decline}</button>
      <button type="button" class="cc-btn cc-accept">{cc.accept}</button>
    </div>
  </div>

  <style>
    .cc-banner {
      position: fixed;
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      z-index: 9999;
      max-width: 640px;
      margin-inline: auto;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.25rem;
      padding: 1rem 1.25rem;
      background: #fff;
      border: 1px solid var(--color-light, #e6e8ec);
      border-radius: 14px;
      box-shadow: var(--shadow-lg, 0 16px 40px rgba(0,0,0,.16));
    }
    /* Author `display: flex` above beats the UA sheet's [hidden] rule, so the
       banner needs an explicit hidden state to disappear on accept/decline. */
    .cc-banner[hidden] { display: none; }
    .cc-text {
      margin: 0;
      flex: 1 1 260px;
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--color-dark, #1a1d24);
    }
    .cc-text a { color: var(--color-primary, #2f9e44); text-decoration: underline; }
    .cc-actions { display: flex; gap: 0.6rem; flex: 0 0 auto; }
    .cc-btn {
      cursor: pointer;
      border-radius: 8px;
      padding: 0.55rem 1.1rem;
      font-size: 0.875rem;
      font-weight: 600;
      font-family: inherit;
      border: 1px solid var(--color-light, #e6e8ec);
    }
    .cc-decline { background: #fff; color: var(--color-dark, #1a1d24); }
    .cc-decline:hover { background: var(--color-bg, #f5f6f8); }
    .cc-accept { background: var(--color-primary, #2f9e44); color: #fff; border-color: var(--color-primary, #2f9e44); }
    .cc-accept:hover { filter: brightness(1.05); }
    @media (max-width: 480px) {
      .cc-actions { width: 100%; }
      .cc-btn { flex: 1; }
    }
  </style>

  <script is:inline>
    // Third-party trackers carried over from Tag Manager container GTM-M7CSJFKX:
    // Leadinfo (company identification + Leadbot chat), the LinkedIn Insight Tag,
    // Hotjar and Bullseye.
    //
    // All four stay unloaded until the visitor accepts the cookie banner, the same
    // rule that applies to GA above. Hotjar was already consent-gated in the
    // container; the other three fired on every page view there, but they set
    // cookies and identify visitors, so gating them is the correct behaviour.
    //
    // Called both on load (for a choice stored on an earlier visit) and straight
    // from the accept button, so the chat appears without needing a reload.
    window.riyLoadConsentedScripts = function () {
      if (window.riyConsentedScriptsLoaded) return;
      window.riyConsentedScriptsLoaded = true;

      // Leadinfo — LI-68482C03CF266
      (function (a, e, f, g, b, h, d, c) {
        a[b] || ((a.GlobalLeadinfoNamespace = a.GlobalLeadinfoNamespace || []),
          a.GlobalLeadinfoNamespace.push(b),
          (a[b] = function () { (a[b].q = a[b].q || []).push(arguments); }),
          (a[b].t = a[b].t || h),
          (a[b].q = a[b].q || []),
          (d = e.createElement(f)),
          (c = e.getElementsByTagName(f)[0]),
          (d.async = 1),
          (d.src = g),
          c.parentNode.insertBefore(d, c));
      })(window, document, 'script', 'https://cdn.leadinfo.net/ping.js', 'leadinfo', 'LI-68482C03CF266');

      // LinkedIn Insight Tag — partner 8312826
      window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
      window._linkedin_data_partner_ids.push('8312826');
      if (!window.lintrk) {
        window.lintrk = function (a, b) { window.lintrk.q.push([a, b]); };
        window.lintrk.q = [];
      }
      var li = document.createElement('script');
      li.async = true;
      li.src = 'https://snap.licdn.com/li.lms-analytics/insight.min.js';
      document.head.appendChild(li);

      // Hotjar — site 6724552
      (function (h, o, t, j, a, r) {
        h.hj = h.hj || function () { (h.hj.q = h.hj.q || []).push(arguments); };
        h._hjSettings = { hjid: 6724552, hjsv: 6 };
        a = o.getElementsByTagName('head')[0];
        r = o.createElement('script');
        r.async = 1;
        r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
        a.appendChild(r);
      })(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');

      // Bullseye
      var bs = document.createElement('script');
      bs.async = true;
      bs.defer = true;
      bs.src = 'https://script.bullseye.so/script/136e696c-eb2e-436f-a9f1-8989e5ecdc3b';
      document.head.appendChild(bs);
    };
  </script>

  <script is:inline>
    // Cookie consent: show the banner until a choice is stored, then update
    // Google Consent Mode v2 accordingly.
    (function () {
      var banner = document.getElementById('cookie-consent');
      if (!banner) return;
      var stored = null;
      try { stored = localStorage.getItem('riy-consent'); } catch (e) {}
      if (!stored) banner.hidden = false;
      if (stored === 'granted') window.riyLoadConsentedScripts();
      function choose(choice) {
        try { localStorage.setItem('riy-consent', choice); } catch (e) {}
        var g = choice === 'granted' ? 'granted' : 'denied';
        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            ad_storage: g, ad_user_data: g, ad_personalization: g, analytics_storage: g,
          });
        }
        if (choice === 'granted') window.riyLoadConsentedScripts();
        banner.hidden = true;
      }
      banner.querySelector('.cc-accept').addEventListener('click', function () { choose('granted'); });
      banner.querySelector('.cc-decline').addEventListener('click', function () { choose('denied'); });
    })();
  </script>

  <script>
    // Calendly: open booking links as an on-page overlay instead of a new tab.
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const a = t.closest('a[href*="calendly.com"]');
      if (!a) return;
      // Track the intent to book (button click) — distinct from the completed
      // booking (schedule_appointment fired on calendly.event_scheduled).
      const gg = (window as any).gtag;
      if (typeof gg === 'function') gg('event', 'begin_appointment', { method: 'calendly' });
      const C = (window as any).Calendly;
      if (C && typeof C.initPopupWidget === 'function') {
        e.preventDefault();
        C.initPopupWidget({ url: (a as HTMLAnchorElement).href });
      }
    });

    // ---------------------------------------------------------------------
    // Google Ads conversions, carried over from container GTM-M7CSJFKX.
    //
    // Each label below fired from its own tag there. Rather than duplicate the
    // trigger logic, they hang off the GA4 events this file already sends, so a
    // trigger only ever has to be maintained in one place.
    // ---------------------------------------------------------------------
    const ADS_ACCOUNT = 'AW-16749801902';

    const adsLabelFor = {
      L_Kwalitatieve_websitebezoeker_30_seconden: 'YM6TCKCW_owaEK7j9rI-',
      L_Telefoon_klik: 'VtNjCPOD3McbEK7j9rI-',
      L_Mail_klik: 'iDvICIPL5N0bEK7j9rI-',
      BL_Leadinfo_klik: '85w-CKzujt0bEK7j9rI-',
      schedule_appointment: 'oQ45CM3e8d0bEK7j9rI-',
    };

    const adsConvert = (label) => {
      const g = (window as any).gtag;
      if (typeof g === 'function' && label) {
        g('event', 'conversion', { send_to: ADS_ACCOUNT + '/' + label });
      }
    };

    // Fire a GA event helper (no-op until consent is granted / gtag exists), plus
    // the matching Ads conversion when there is one.
    const track = (name, params) => {
      const g = (window as any).gtag;
      if (typeof g === 'function') g('event', name, params || {});
      adsConvert(adsLabelFor[name]);
    };

    // Reaching the contact page was its own Ads conversion, with no GA4 event
    // beside it, so it is triggered on the path directly.
    if (/^\/(en\/)?contact\/?$/.test(location.pathname)) {
      adsConvert('E58OCOXY2t0bEK7j9rI-');
    }

    // Form submissions land on a thank-you page. The container measured these
    // inside the old popup forms; the per-product label is derived from the
    // page's own source marker instead.
    const adsLabelForFormSource = {
      billing: 'c-P2CMWbg40aEK7j9rI-',
      sharepoint: 'nBW4CMubg40aEK7j9rI-',
    };
    const ty = document.querySelector('.ty[data-ty-source]');
    if (ty) adsConvert(adsLabelForFormSource[(ty as HTMLElement).dataset.tySource]);

    // Opening the Billing demo form. The container keyed this off the old
    // #demoBillingPopup link; the modal on the Billing page replaces it.
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const a = t.closest('a[href="#demo"]');
      if (a && /billing-module/.test(location.pathname)) {
        adsConvert('u3UUCKOW_owaEK7j9rI-');
      }
    });

    // Pardot form engagement: the form template posts a "form_start" event
    // when the visitor first focuses a field.
    window.addEventListener('message', (e) => {
      const ev = e.data && typeof e.data === 'object' ? (e.data as any).pardotEvent : null;
      if (ev === 'form_start') track('form_start', { method: 'pardot' });
    });

    // Calendly: fire a conversion when a booking is completed in the overlay.
    window.addEventListener('message', (e) => {
      const d = e.data;
      if (d && typeof d === 'object' && (d as any).event === 'calendly.event_scheduled') {
        track('schedule_appointment', { method: 'calendly' });
      }
    });

    // ---------------------------------------------------------------------
    // Engagement events carried over from Tag Manager container GTM-M7CSJFKX.
    //
    // The event names are deliberately the container's own, not GA4 standard
    // names: existing reports, audiences and Google Ads conversions are keyed on
    // these strings, so renaming them would silently break historical continuity.
    // The click_url parameter matches what the old tags sent (gtm.elementUrl).
    // ---------------------------------------------------------------------

    // Link clicks, matched against the href like the old triggers did. Order
    // matters only in that every match fires; a link can satisfy more than one
    // rule, which is how the container behaved too.
    const linkRules = [
      { event: 'L_Telefoon_klik', test: (h) => h.startsWith('tel:') },
      { event: 'L_Mail_klik', test: (h) => h.startsWith('mailto:') },
      { event: 'L_Socials_klik', test: (h) => h.includes('linkedin.com') || h.includes('wa.me') },
      { event: 'L_App_Exchange_klik', test: (h) => h.includes('appexchange.salesforce.com') },
      // Matched on the raw attribute so an in-page anchor still counts, and
      // excluding tel:/mailto: keeps contact@ addresses out of this one.
      {
        event: 'L_Klik_naar_contact',
        test: (h) => h.includes('contact') && !h.startsWith('tel:') && !h.startsWith('mailto:'),
      },
    ];

    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const a = t.closest('a[href]');
      if (!a) return;
      const href = a.getAttribute('href') || '';
      const absolute = (a as HTMLAnchorElement).href || href;

      for (const rule of linkRules) {
        if (rule.test(href)) track(rule.event, { click_url: absolute });
      }

      // The old container keyed this off an .apply-button class. The vacancy CTA
      // is a plain link to /contact now, so it is marked up explicitly instead.
      if (a.hasAttribute('data-track-apply')) {
        track('L_Sollicitatie_start', { click_url: absolute });
      }
    });

    // Booking-intent click. begin_appointment above is the GA4-standard name for
    // the same action; both fire so the older reports keep working.
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const a = t.closest('a[href*="calendly.com"]');
      if (a) track('BL_Calendly_klik', { click_url: (a as HTMLAnchorElement).href });
    });

    // Visiting the appointment page at all was tracked separately.
    if (/afspraak/i.test(location.pathname + location.hash)) {
      track('BL_Calendly_page_visit', { click_url: location.href });
    }

    // Qualified-visitor signal: still on the page after 30 seconds, fired once.
    window.setTimeout(() => track('L_Kwalitatieve_websitebezoeker_30_seconden', {}), 30000);

    // Leadinfo reports chat interactions by pushing to dataLayer. With Tag
    // Manager gone nothing consumes those pushes, so watch for the one the old
    // container forwarded. gtag's own pushes carry no eventAction, so they fall
    // straight through without recursing.
    const dl = (window as any).dataLayer;
    if (dl && typeof dl.push === 'function') {
      const originalPush = dl.push.bind(dl);
      dl.push = function (...entries) {
        for (const entry of entries) {
          const action = entry && typeof entry === 'object' ? (entry as any).eventAction : null;
          if (typeof action === 'string' && action.includes('leadinfo_opened_by_click')) {
            track('BL_Leadinfo_klik', {});
          }
        }
        return originalPush(...entries);
      };
    }

    // ---------------------------------------------------------------------
    // Google Ads click id into the Pardot forms.
    //
    // The forms have a gclid field that Pardot prefills from the iframe's own
    // query string, but the iframe is cross-origin so the value has to be in the
    // src. A visitor usually lands on an ad page and converts on another one, so
    // the id is remembered rather than read from the current URL only.
    //
    // Persisting it is gated on cookie consent, matching how gtag holds back
    // ad_storage until the banner is accepted. A gclid in the URL of the page
    // being viewed is always honoured, consent or not: that is the visitor's own
    // navigation and it never outlives the page load.
    // ---------------------------------------------------------------------
    const GCLID_KEY = 'riy-gclid';

    const readGclid = () => {
      const fromUrl = new URLSearchParams(location.search).get('gclid');
      if (fromUrl) {
        try {
          if (localStorage.getItem('riy-consent') === 'granted') {
            localStorage.setItem(GCLID_KEY, fromUrl);
          }
        } catch (e) {}
        return fromUrl;
      }
      try {
        return localStorage.getItem(GCLID_KEY);
      } catch (e) {
        return null;
      }
    };

    const gclid = readGclid();

    const applyGclid = () => {
      if (!gclid) return;
      document.querySelectorAll('iframe.pardot-form').forEach((node) => {
        const frame = node as HTMLIFrameElement;
        const raw = frame.getAttribute('src');
        if (!raw) return;
        const url = new URL(raw, location.href);
        // Skip if it is already correct, so this never reloads a form needlessly.
        if (url.searchParams.get('gclid') === gclid) return;
        url.searchParams.set('gclid', gclid);
        frame.setAttribute('src', url.toString());
      });
    };

    if (gclid) {
      applyGclid();
      // Forms inside modals can be added later, so re-apply as nodes appear. The
      // equality guard above stops this from looping on its own mutations.
      if ('MutationObserver' in window) {
        new MutationObserver(applyGclid).observe(document.body, { childList: true, subtree: true });
      }
    }

    // Auto-resize embedded Pardot form iframes to their content height
    // (the form layout template posts its height via postMessage).
    window.addEventListener('message', (e) => {
      const data = e.data;
      const h = data && typeof data === 'object' ? (data.pardotHeight || data.height) : null;
      if (typeof h !== 'number' || h < 80) return;
      const target = Math.min(Math.round(h), 1800);
      document.querySelectorAll('iframe.pardot-form').forEach((f) => {
        const frame = f as HTMLIFrameElement;
        if (frame.contentWindow !== e.source) return;
        const current = parseInt(frame.style.height) || 0;
        if (Math.abs(target - current) > 4) frame.style.height = target + 'px';
      });
    });

    // Scroll-reveal: reveal elements with .reveal as they enter the viewport.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
      els.forEach((el) => io.observe(el));
    }

    // Count-up animation for [data-count] elements.
    const counters = document.querySelectorAll('[data-count]');
    if (counters.length && !reduce && 'IntersectionObserver' in window) {
      const cio = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          const target = parseFloat(el.dataset.count);
          const suffix = el.dataset.suffix || '';
          const dur = 1400;
          const start = performance.now();
          const tick = (now) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          cio.unobserve(el);
        });
      }, { threshold: 0.5 });
      counters.forEach((el) => cio.observe(el));
    }
  </script>
</body>
</html>
