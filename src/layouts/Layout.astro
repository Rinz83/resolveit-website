---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, translatedPaths } from '../i18n/ui.js';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
  noindex?: boolean;
  image?: string;
  ogType?: string;
  breadcrumbs?: { name: string; item: string }[];
  // Override for pages whose language differs from their URL prefix
  // (e.g. the English campaign LP that lives on the NL root).
  lang?: 'nl' | 'en';
}

// Default social-share image: purpose-built 1200x630 branded OG card.
const DEFAULT_OG_IMAGE = '/images/og-default.png';

const {
  title,
  description = 'Resolve IT helpt organisaties het volledige potentieel van Salesforce te benutten. Implementatie, integraties, training en consultancy.',
  transparentHeader = true,
  noindex = false,
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  breadcrumbs,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.resolveit.nl');
const lang = Astro.props.lang ?? (Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/') ? 'en' : 'nl');
const ogImage = new URL(image, Astro.site ?? 'https://www.resolveit.nl').href;
const ogLocale = lang === 'en' ? 'en_GB' : 'nl_NL';

// hreflang alternates: emit NL/EN links only for pages that exist in both
// languages (the primary language flipped to NL at root, EN under /en/).
const siteBase = Astro.site ?? 'https://www.resolveit.nl';
const pn = Astro.url.pathname;
const nlClean = (getLangFromUrl(pn) === 'en' ? pn.replace(/^\/en/, '') : pn).replace(/\/$/, '') || '/';
const hasAlternate = translatedPaths.has(nlClean);
// Trailing-slash form, matching the canonical URLs, so hreflang and canonical
// point at the same URL variant.
const nlHref = new URL(nlClean === '/' ? '/' : `${nlClean}/`, siteBase).href;
const enHref = new URL(nlClean === '/' ? '/en/' : `/en${nlClean}/`, siteBase).href;

// Cookie-consent banner copy (bilingual).
const cc = lang === 'en'
  ? { text: 'We use cookies to analyse website traffic and improve your experience.',
      more: 'Cookie policy', link: '/en/cookiebeleid', accept: 'Accept', decline: 'Decline' }
  : { text: 'We gebruiken cookies om websiteverkeer te analyseren en onze site te verbeteren.',
      more: 'Cookiebeleid', link: '/cookiebeleid', accept: 'Accepteren', decline: 'Weigeren' };
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- Google Tag Manager (GTM-M7CSJFKX), beheerd door de marketingpartner. Alle
       tags (GA4, Ads, Leadinfo, LinkedIn, Hotjar, Bullseye) leven in de container;
       de site stuurt alleen nog dataLayer-events voor wat de container niet zelf
       kan zien (zie docs/analytics-events.md). De Consent Mode v2 defaults staan
       bewust vóór de container: opslag blijft denied tot de bezoeker de
       cookiebanner accepteert (AVG/GDPR). -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
    // Re-apply a stored choice from a previous visit before the container loads.
    try {
      if (localStorage.getItem('riy-consent') === 'granted') {
        gtag('consent', 'update', {
          ad_storage: 'granted', ad_user_data: 'granted',
          ad_personalization: 'granted', analytics_storage: 'granted',
        });
      }
    } catch (e) {}
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-M7CSJFKX');
  </script>
  <!-- End Google Tag Manager -->

  <title>{title} | Resolve IT</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />

  {hasAlternate && (
    <>
      <link rel="alternate" hreflang="nl-NL" href={nlHref} />
      <link rel="alternate" hreflang="en" href={enHref} />
      <link rel="alternate" hreflang="x-default" href={nlHref} />
    </>
  )}

  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${title} | Resolve IT`} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={`${title} | Resolve IT`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Resolve IT`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Organization + WebSite entity (site-wide) — helps Google's Knowledge
       Panel and AI engines identify and cite the brand. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': 'https://www.resolveit.nl/#organization',
        name: 'Resolve IT',
        url: 'https://www.resolveit.nl/',
        logo: 'https://www.resolveit.nl/images/Logo-colored.png',
        email: 'contact@resolveit.nl',
        telephone: '+31411799828',
        description: lang === 'en'
          ? 'Salesforce Gold Partner: implementation, integrations, training and consultancy.'
          : 'Salesforce Gold Partner: implementatie, integraties, training en consultancy.',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Clarissenhof 336',
          postalCode: '5047 RW',
          addressLocality: 'Tilburg',
          addressCountry: 'NL',
        },
        foundingDate: '2019',
        vatID: 'NL860777157B01',
        // KvK-nummer as a typed identifier so registers and AI engines can
        // verify the legal entity behind the site.
        identifier: {
          '@type': 'PropertyValue',
          propertyID: 'KVK',
          value: '76723364',
        },
        sameAs: [
          'https://www.linkedin.com/company/resolveitnow/',
          'https://appexchange.salesforce.com/appxListingDetail?listingId=af6947f7-045b-4d53-b61c-6076f7082235',
        ],
      },
      {
        '@type': 'WebSite',
        '@id': 'https://www.resolveit.nl/#website',
        url: 'https://www.resolveit.nl/',
        name: 'Resolve IT',
        publisher: { '@id': 'https://www.resolveit.nl/#organization' },
        inLanguage: lang === 'en' ? 'en' : 'nl-NL',
      },
    ],
  })} is:inline />

  {breadcrumbs && breadcrumbs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.item, 'https://www.resolveit.nl').href,
      })),
    })} is:inline />
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Salesforce Account Engagement (Pardot) — account 982612, campaign 28209.
       Lived in the old WordPress theme rather than in Tag Manager, which is why it
       disappeared with the rebuild and the dashboard went quiet.

       Loaded from go.resolveit.nl, the tracker domain that already serves the
       forms, instead of the old pi.pardot.com: same script, but the visitor cookie
       is first-party, so Safari and Firefox no longer discard it.

       Deliberately NOT behind the cookie banner, unlike the trackers further down,
       so page views are recorded for every visitor. Note that first-party only
       decides whether browsers keep the cookie, not whether consent is required;
       this is an explicit business decision, not an oversight. -->
  <script is:inline>
    // 981612, not the 982612 the old WordPress theme declared. Pardot attributes
    // the visitor to whichever account owns the tracker domain: sending 982612
    // still came back with a `visitor_id981612` cookie, and the forms live at
    // go.resolveit.nl/l/981612/. Declaring the account it actually lands in keeps
    // the hit and the cookie from disagreeing.
    window.piAId = '981612';
    window.piCId = '28209';
    window.piHostname = 'go.resolveit.nl';
  </script>
  <script async src="https://go.resolveit.nl/pd.js" is:inline></script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- Calendly assets load on first click of a booking link (see the click
       handler below) instead of on every pageview: ~60 KB saved per visit. -->
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M7CSJFKX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <Nav transparent={transparentHeader} lang={lang} />
  <main id="main-content">
    <slot />
  </main>
  <Footer lang={lang} />

  <div id="cookie-consent" class="cc-banner" hidden>
    <p class="cc-text">
      {cc.text} <a href={cc.link}>{cc.more}</a>
    </p>
    <div class="cc-actions">
      <button type="button" class="cc-btn cc-decline">{cc.decline}</button>
      <button type="button" class="cc-btn cc-accept">{cc.accept}</button>
    </div>
  </div>

  <style>
    .cc-banner {
      position: fixed;
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      z-index: 9999;
      max-width: 640px;
      margin-inline: auto;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.25rem;
      padding: 1rem 1.25rem;
      background: #fff;
      border: 1px solid var(--color-light, #e6e8ec);
      border-radius: 14px;
      box-shadow: var(--shadow-lg, 0 16px 40px rgba(0,0,0,.16));
    }
    /* Author `display: flex` above beats the UA sheet's [hidden] rule, so the
       banner needs an explicit hidden state to disappear on accept/decline. */
    .cc-banner[hidden] { display: none; }
    .cc-text {
      margin: 0;
      flex: 1 1 260px;
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--color-dark, #1a1d24);
    }
    .cc-text a { color: var(--color-primary, #2f9e44); text-decoration: underline; }
    .cc-actions { display: flex; gap: 0.6rem; flex: 0 0 auto; }
    .cc-btn {
      cursor: pointer;
      border-radius: 8px;
      padding: 0.55rem 1.1rem;
      font-size: 0.875rem;
      font-weight: 600;
      font-family: inherit;
      border: 1px solid var(--color-light, #e6e8ec);
    }
    .cc-decline { background: #fff; color: var(--color-dark, #1a1d24); }
    .cc-decline:hover { background: var(--color-bg, #f5f6f8); }
    .cc-accept { background: var(--color-primary, #2f9e44); color: #fff; border-color: var(--color-primary, #2f9e44); }
    .cc-accept:hover { filter: brightness(1.05); }
    @media (max-width: 480px) {
      .cc-actions { width: 100%; }
      .cc-btn { flex: 1; }
    }
  </style>

  <script is:inline>
    // Cookie consent: show the banner until a choice is stored, then update
    // Google Consent Mode v2 accordingly. The third-party trackers (Leadinfo,
    // LinkedIn, Hotjar, Bullseye) load via the Tag Manager container; consent
    // gating for those tags is configured in the container itself.
    (function () {
      var banner = document.getElementById('cookie-consent');
      if (!banner) return;
      var stored = null;
      try { stored = localStorage.getItem('riy-consent'); } catch (e) {}
      if (!stored) banner.hidden = false;
      function choose(choice) {
        try { localStorage.setItem('riy-consent', choice); } catch (e) {}
        var g = choice === 'granted' ? 'granted' : 'denied';
        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            ad_storage: g, ad_user_data: g, ad_personalization: g, analytics_storage: g,
          });
        }
        banner.hidden = true;
      }
      banner.querySelector('.cc-accept').addEventListener('click', function () { choose('granted'); });
      banner.querySelector('.cc-decline').addEventListener('click', function () { choose('denied'); });
    })();
  </script>

  <script>
    // Measurement lives in the Tag Manager container (GTM-M7CSJFKX) again. The
    // site only pushes dataLayer events for what the container cannot see from
    // the outside (postMessages, page markers); click-based events and timers
    // are the container's own triggers. See docs/analytics-events.md.
    const dlPush = (event: string, params?: Record<string, unknown>) => {
      ((window as any).dataLayer = (window as any).dataLayer || []).push({ event, ...(params || {}) });
    };

    // Remember the page language for the bilingual thank-you pages. A Pardot
    // form redirects there from inside its go.resolveit.nl iframe, so the
    // referrer carries no language information. The thank-you pages themselves
    // are excluded: they read this marker and must not overwrite it.
    if (!/^\/thank-you-/.test(location.pathname)) {
      try { sessionStorage.setItem('riy-lang', document.documentElement.lang || 'nl'); } catch (e) {}
    }

    // Calendly: open booking links as an on-page overlay instead of a new tab.
    // The widget assets load on the first click rather than on every pageview;
    // if loading fails, the link falls back to opening Calendly in a new tab.
    let calendlyLoading: Promise<any> | null = null;
    const loadCalendly = () => {
      if ((window as any).Calendly) return Promise.resolve((window as any).Calendly);
      if (!calendlyLoading) {
        calendlyLoading = new Promise((resolve, reject) => {
          const l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = 'https://assets.calendly.com/assets/external/widget.css';
          document.head.appendChild(l);
          const s = document.createElement('script');
          s.src = 'https://assets.calendly.com/assets/external/widget.js';
          s.async = true;
          s.onload = () => resolve((window as any).Calendly);
          s.onerror = () => { calendlyLoading = null; reject(new Error('calendly load failed')); };
          document.head.appendChild(s);
        });
      }
      return calendlyLoading;
    };

    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const a = t.closest('a[href*="calendly.com"]');
      if (!a) return;
      // Track the intent to book (button click) — distinct from the completed
      // booking (schedule_appointment fired on calendly.event_scheduled).
      dlPush('begin_appointment', { method: 'calendly' });
      const href = (a as HTMLAnchorElement).href;
      e.preventDefault();
      loadCalendly()
        .then((C) => {
          if (C && typeof C.initPopupWidget === 'function') C.initPopupWidget({ url: href });
          else window.open(href, '_blank', 'noopener');
        })
        .catch(() => window.open(href, '_blank', 'noopener'));
    });

    // ---------------------------------------------------------------------
    // dataLayer events for the Tag Manager container.
    //
    // Only the things the container cannot derive from clicks or pageviews
    // itself are pushed here. Phone/mail/social clicks, the 30-second timer,
    // Leadinfo-chat interactions and the contact pageview are the container's
    // own triggers again, exactly as before the rebuild.
    // ---------------------------------------------------------------------

    // Opening the Billing demo form. The old container keyed this off the
    // #demoBillingPopup link; the modal on the Billing page replaces it.
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const a = t.closest('a[href="#demo"]');
      if (a && /billing-module/.test(location.pathname)) {
        dlPush('billing_demo_open', { click_url: location.href });
      }
    });

    // Vacancy CTA. The old container keyed this off an .apply-button class
    // that no longer exists, so the link is marked up explicitly instead.
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const a = t.closest('a[data-track-apply][href]');
      if (a) dlPush('L_Sollicitatie_start', { click_url: (a as HTMLAnchorElement).href });
    });

    // Pardot form engagement: the form template posts a "form_start" event
    // when the visitor first focuses a field.
    window.addEventListener('message', (e) => {
      const ev = e.data && typeof e.data === 'object' ? (e.data as any).pardotEvent : null;
      if (ev === 'form_start') dlPush('form_start', { method: 'pardot' });
    });

    // Calendly: a booking completed in the overlay. The container cannot see
    // this postMessage itself because the overlay is created by this script.
    window.addEventListener('message', (e) => {
      const d = e.data;
      if (d && typeof d === 'object' && (d as any).event === 'calendly.event_scheduled') {
        dlPush('schedule_appointment', { method: 'calendly' });
      }
    });

    // ---------------------------------------------------------------------
    // Ad click ids into the Pardot forms: gclid (Google Ads) and msclkid
    // (Microsoft/Bing Ads).
    //
    // The forms have hidden fields that Pardot prefills from the iframe's own
    // query string, but the iframe is cross-origin so the values have to be in
    // the src. A visitor usually lands on an ad page and converts on another
    // one, so the ids are remembered rather than read from the current URL only.
    //
    // Persisting them is gated on cookie consent, matching how ad_storage is
    // held back until the banner is accepted. An id in the URL of the page
    // being viewed is always honoured, consent or not: that is the visitor's
    // own navigation and it never outlives the page load.
    // ---------------------------------------------------------------------
    const CLICK_ID_PARAMS = ['gclid', 'msclkid'];

    const readClickId = (param: string) => {
      const fromUrl = new URLSearchParams(location.search).get(param);
      if (fromUrl) {
        try {
          if (localStorage.getItem('riy-consent') === 'granted') {
            localStorage.setItem('riy-' + param, fromUrl);
          }
        } catch (e) {}
        return fromUrl;
      }
      try {
        return localStorage.getItem('riy-' + param);
      } catch (e) {
        return null;
      }
    };

    const clickIds = CLICK_ID_PARAMS
      .map((param) => ({ param, value: readClickId(param) }))
      .filter((c) => c.value);

    const applyClickIds = () => {
      document.querySelectorAll('iframe.pardot-form').forEach((node) => {
        const frame = node as HTMLIFrameElement;
        const raw = frame.getAttribute('src');
        if (!raw) return;
        const url = new URL(raw, location.href);
        // Skip if everything is already correct, so this never reloads a form
        // needlessly (the MutationObserver below would loop otherwise).
        let changed = false;
        for (const { param, value } of clickIds) {
          if (url.searchParams.get(param) !== value) {
            url.searchParams.set(param, value);
            changed = true;
          }
        }
        if (changed) frame.setAttribute('src', url.toString());
      });
    };

    if (clickIds.length > 0) {
      applyClickIds();
      // Forms inside modals can be added later, so re-apply as nodes appear.
      if ('MutationObserver' in window) {
        new MutationObserver(applyClickIds).observe(document.body, { childList: true, subtree: true });
      }
    }

    // Auto-resize embedded Pardot form iframes to their content height
    // (the form layout template posts its height via postMessage).
    window.addEventListener('message', (e) => {
      const data = e.data;
      const h = data && typeof data === 'object' ? (data.pardotHeight || data.height) : null;
      if (typeof h !== 'number' || h < 80) return;
      const target = Math.min(Math.round(h), 1800);
      document.querySelectorAll('iframe.pardot-form').forEach((f) => {
        const frame = f as HTMLIFrameElement;
        if (frame.contentWindow !== e.source) return;
        const current = parseInt(frame.style.height) || 0;
        if (Math.abs(target - current) > 4) frame.style.height = target + 'px';
      });
    });

    // Scroll-reveal: reveal elements with .reveal as they enter the viewport.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
      els.forEach((el) => io.observe(el));
    }

    // Count-up animation for [data-count] elements.
    const counters = document.querySelectorAll('[data-count]');
    if (counters.length && !reduce && 'IntersectionObserver' in window) {
      const cio = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          const target = parseFloat(el.dataset.count);
          const suffix = el.dataset.suffix || '';
          // The markup ships the final value so crawlers and no-JS visitors never
          // see "0 projects"; reset to 0 only here, right before animating.
          el.textContent = '0';
          const dur = 1400;
          const start = performance.now();
          const tick = (now) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          cio.unobserve(el);
        });
      }, { threshold: 0.5 });
      counters.forEach((el) => cio.observe(el));
    }
  </script>
</body>
</html>
