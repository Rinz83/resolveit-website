---
import Layout from '../layouts/Layout.astro';
import ThankYou from '../components/ThankYou.astro';
---
<Layout title="Bedankt" description="Bedankt voor uw interesse in de Influx Business Central Connector." noindex={true}>
  <ThankYou
    message="Bedankt voor uw interesse in onze Business Central-integratie. We nemen op korte termijn contact met u op om uw demo in te plannen."
    messageEn="Thank you for your interest in our Business Central integration. We'll contact you on short notice to arrange your demo."
    ctaHref="/producten/business-central"
    ctaLabel="Terug naar Business Central Connector"
    ctaLabelEn="Back to Business Central Connector"
    source="business-central"
  />
</Layout>
