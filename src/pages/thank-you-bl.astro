---
import Layout from '../layouts/Layout.astro';
import ThankYou from '../components/ThankYou.astro';
---
<Layout title="Bedankt" description="Bedankt voor uw interesse in het Billing Platform." noindex={true}>
  <ThankYou
    message="Bedankt voor uw interesse in ons Billing Platform. We nemen op korte termijn contact met u op."
    messageEn="Thank you for your interest in our Billing Platform. We'll contact you on short notice."
    ctaHref="/producten/billing-module"
    ctaLabel="Terug naar Billing Platform"
    ctaLabelEn="Back to Billing Platform"
    source="billing"
  />
</Layout>
