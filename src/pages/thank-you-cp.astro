---
import Layout from '../layouts/Layout.astro';
import ThankYou from '../components/ThankYou.astro';
---
<Layout title="Bedankt" description="Bedankt voor uw bericht aan Resolve IT." noindex={true}>
  <ThankYou
    message="Bedankt voor uw bericht. We komen er op korte termijn bij u op terug."
    messageEn="Thank you for your message. We'll get back to you on short notice."
    ctaHref="/producten"
    ctaLabel="Bekijk onze producten"
    ctaLabelEn="Explore our products"
    source="contact"
  />
</Layout>
