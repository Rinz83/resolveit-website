---
import Layout from '../layouts/Layout.astro';
import ThankYou from '../components/ThankYou.astro';
---
<Layout title="Bedankt" description="Bedankt voor uw interesse in Influx for Exact Online." noindex={true}>
  <ThankYou
    message="Bedankt voor uw interesse in onze Exact Online-integratie. We nemen op korte termijn contact met u op om uw demo in te plannen."
    messageEn="Thank you for your interest in our Exact Online integration. We'll contact you on short notice to arrange your demo."
    ctaHref="/producten/exact-online"
    ctaLabel="Terug naar Exact Online"
    ctaLabelEn="Back to Exact Online"
    source="exact"
  />
</Layout>
