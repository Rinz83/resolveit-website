---
import Layout from '../layouts/Layout.astro';
import ThankYou from '../components/ThankYou.astro';
---
<Layout title="Bedankt" description="Bedankt voor uw interesse in SignFlow." noindex={true}>
  <ThankYou
    message="Bedankt voor uw interesse in SignFlow. We nemen op korte termijn contact met u op om uw demo in te plannen."
    messageEn="Thank you for your interest in SignFlow. We'll contact you on short notice to arrange your demo."
    ctaHref="/producten/signflow"
    ctaLabel="Terug naar SignFlow"
    ctaLabelEn="Back to SignFlow"
    source="signflow"
  />
</Layout>
