---
import Layout from '../layouts/Layout.astro';
import ThankYou from '../components/ThankYou.astro';
---
<Layout title="Bedankt" description="Bedankt voor uw interesse in SalesPoint." noindex={true}>
  <ThankYou
    message="Bedankt voor uw interesse in SalesPoint. We nemen op korte termijn contact met u op."
    messageEn="Thank you for your interest in SalesPoint. We'll contact you on short notice."
    ctaHref="/producten/sharepoint"
    ctaLabel="Terug naar SalesPoint"
    ctaLabelEn="Back to SalesPoint"
    source="sharepoint"
  />
</Layout>
