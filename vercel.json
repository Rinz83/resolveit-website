{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "resolveit.nl" }],
      "destination": "https://www.resolveit.nl/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "resolveit.nl" }],
      "destination": "https://www.resolveit.nl/:path+",
      "permanent": true
    }
  ]
}
